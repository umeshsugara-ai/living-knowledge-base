# secrets
**/.env
**/.env.*
!**/.env.example

# node
**/node_modules/
**/dist/

# playwright artifacts
**/.playwright-mcp/

# large media (raw data lives under raw/, never in the code tree — D-003)
raw/TOC/TOC-Materials/Audio/
raw/TOC/TOC-Materials/Recordings/

# sources/whatsapp_msg is a git submodule with its own .gitignore (media/, sessions/, .env)

# reference screenshots (large, regenerable)
reference/kb-deck-screens/*.jpg
reference/kb-deck-screens/*.png

# logs
*.log

# python bytecode
**/__pycache__/
*.pyc

# claude-code local state
.claude/scheduled_tasks.lock

# goal tracker regenerated artefacts
.goal/dashboard.html
.goal/monitor_task.cmd
.goal/monitor_task.vbs
.goal/audits/

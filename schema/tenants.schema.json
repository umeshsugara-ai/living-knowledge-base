{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb://tenants",
  "title": "tenants",
  "description": "The tenant's own row — PK is the tenant, so this is the one collection exempt from requiring tenantId (ADR-0001, C3).",
  "type": "object",
  "required": ["_id", "name"],
  "properties": {
    "_id": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}

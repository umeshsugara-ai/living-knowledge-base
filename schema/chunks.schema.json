{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb://chunks",
  "title": "chunks",
  "description": "H1 unstructured vector index. Chunks reference turns by id only — text is derived from turns at embed time, never duplicated (ADR-0001).",
  "type": "object",
  "required": ["_id", "tenantId", "sourceRef", "turnRefs"],
  "properties": {
    "_id": { "type": "string" },
    "tenantId": { "type": "string", "minLength": 1 },
    "sourceRef": { "type": "string", "minLength": 1 },
    "turnRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "embeddingRef": { "type": "string" },
    "embeddingModel": { "type": "string" }
  },
  "additionalProperties": true
}

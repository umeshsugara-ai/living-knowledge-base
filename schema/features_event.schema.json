{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb://features_event",
  "title": "features_event",
  "description": "One line of docs/FEATURES.jsonl — a single feature lifecycle event (T-017b). The ledger file is append-only newline-delimited JSON; each line independently validates against this schema (matches schema/validate.py's existing per-collection single-doc fixture pattern — no JSONL-aware extension needed).",
  "type": "object",
  "required": ["id", "feature", "event", "date", "unit", "links"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "feature": { "type": "string", "minLength": 1 },
    "event": { "type": "string", "enum": ["planned", "shipped", "updated", "removed"] },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "unit": { "type": "string", "minLength": 1 },
    "reason": { "type": ["string", "null"] },
    "links": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": {
        "properties": { "event": { "enum": ["updated", "removed"] } },
        "required": ["event"]
      },
      "then": {
        "required": ["reason"],
        "properties": { "reason": { "type": "string", "minLength": 1 } }
      }
    }
  ],
  "additionalProperties": true
}

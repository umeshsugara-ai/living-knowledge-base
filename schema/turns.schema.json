{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb://turns",
  "title": "turns",
  "type": "object",
  "required": ["_id", "tenantId", "sessionId", "speakerRef", "tStart", "tEnd", "text"],
  "properties": {
    "_id": { "type": "string" },
    "tenantId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string" },
    "speakerRef": { "type": "string", "description": "raw label (e.g. spk:0) or resolved personId" },
    "tStart": { "type": "number", "minimum": 0 },
    "tEnd": { "type": "number", "minimum": 0 },
    "text": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "additionalProperties": true
}

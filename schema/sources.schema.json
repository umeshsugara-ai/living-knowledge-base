{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb://sources",
  "title": "sources",
  "type": "object",
  "required": ["_id", "tenantId", "kind", "hash", "consent", "createdAt", "captureMode"],
  "properties": {
    "_id": { "type": "string" },
    "tenantId": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["recording", "document", "spreadsheet", "whatsapp-batch", "url"] },
    "captureMode": {
      "type": "string",
      "enum": ["provided", "public", "notes", "silent"],
      "description": "D-008 provided-first capture ordering: organizer-provided > public > notes/live-transcript > silent (last resort)."
    },
    "path": { "type": "string" },
    "url": { "type": "string", "description": "Origin URL for kind: 'url' sources (T-023)." },
    "hash": { "type": "string", "minLength": 8 },
    "consent": {
      "type": "object",
      "required": ["given", "recordedBy"],
      "properties": {
        "given": { "type": "boolean" },
        "recordedBy": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}

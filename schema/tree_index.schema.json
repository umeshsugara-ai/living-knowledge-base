{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb://tree_index",
  "title": "tree_index node",
  "type": "object",
  "required": ["node_id", "title", "level", "summary", "children"],
  "properties": {
    "node_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "level": { "type": "string", "enum": ["tenant", "year", "month", "session", "topic", "org"] },
    "summary": { "type": "string" },
    "evidence": {
      "type": "object",
      "properties": {
        "sessionRef": { "type": "string" }
      }
    },
    "children": {
      "type": "array",
      "items": { "$ref": "kb://tree_index" }
    }
  },
  "additionalProperties": true
}

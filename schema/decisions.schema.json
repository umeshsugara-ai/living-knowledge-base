{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb://decisions",
  "title": "decisions",
  "type": "object",
  "required": ["_id", "tenantId", "text", "status", "evidence"],
  "properties": {
    "_id": { "type": "string" },
    "tenantId": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "owner": { "type": "string" },
    "status": { "type": "string", "enum": ["proposed", "verified", "needs-review"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["turn_id", "session_id"],
        "properties": {
          "turn_id": { "type": "string" },
          "session_id": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": true
}

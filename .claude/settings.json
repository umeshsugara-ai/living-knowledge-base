{
  "_comment": "Lab Protocol project settings, scaffolded by /init-lab. Paths are $CLAUDE_PROJECT_DIR-relative.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -Command \"$i=[Console]::In.ReadToEnd(); & \\\"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\lab-session-start.ps1\\\" -InputJson $i\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -Command \"$i=[Console]::In.ReadToEnd(); & \\\"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\lab-session-end.ps1\\\" -InputJson $i\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -Command \"$i=[Console]::In.ReadToEnd(); & \\\"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\decisions-append-guard.ps1\\\" -InputJson $i\""
          }
        ]
      }
    ]
  }
}
